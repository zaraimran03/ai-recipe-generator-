# ── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ai_recipe_db

# ── JWT Secrets (generate strong random strings) ─────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars

# ── Groq AI ─────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── EmailJS (server-side SDK) ───────────────────────────
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID_VERIFY=your_verify_template_id
EMAILJS_TEMPLATE_ID_RESET=your_reset_template_id

# ── Server ──────────────────────────────────────────────
PORT=8000
